# Small, pinned base image; no build tools in the final image.
FROM docker.io/library/python:3.12-slim

LABEL org.opencontainers.image.source="https://github.com/atonyhonesto/article-labs" \
      org.opencontainers.image.description="race-status demo service"

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 APP_VERSION=1.0.0 PORT=8080

# Unprivileged user with a fixed UID, so file ownership is predictable on the host.
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
WORKDIR /app
COPY --chown=root:root app.py .

USER 10001
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health')"
CMD ["python", "app.py"]
